# ===== 複製本檔為 .env 再按需要修改：cp .env.example .env =====

# ---- API ----
# 宿主機對外端口（docker compose 用）
API_PORT=8000

# ---- PostgreSQL ----
POSTGRES_USER=webapi
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=webapi
# docker compose 內固定用 db；本機直接跑 uvicorn 時改成 localhost（compose 會強制覆寫成 db）
POSTGRES_HOST=db
POSTGRES_PORT=5432

# 完整非同步 DSN 覆寫（留空 = 由上面的 POSTGRES_* 組合）
DATABASE_URL=

# ---- 應用 ----
ENVIRONMENT=development
LOG_LEVEL=INFO
# 容器啟動時自動執行 alembic upgrade head（設 false 可關閉）
RUN_MIGRATIONS=true
# 逗號分隔的允許 origin
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# ---- 宿主機 PostgreSQL 端口 ----
# 只用來做 port mapping；如果本機 5432 被佔用可改成 5433
DB_PORT=5432

# ---- 容器 entrypoint 等待 DB 的重試參數（可選）----
# DB_WAIT_MAX_ATTEMPTS=30
# DB_WAIT_DELAY_SECONDS=2
